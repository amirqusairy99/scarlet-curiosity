{
  "name": "scarlet-curiosity",
  "version": "1.0.0",
  "description": "MIS Ticketing System with Cloudflare Pages, D1 Database, and R2 Object Storage",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pages:dev": "wrangler pages dev public",
    "pages:deploy": "wrangler pages deploy public",
    "d1:create": "wrangler d1 create scarlet-curiosity-db",
    "d1:init-local": "wrangler d1 execute scarlet-curiosity-db --local --file=schema-d1.sql",
    "d1:init-remote": "wrangler d1 execute scarlet-curiosity-db --remote --file=schema-d1.sql",
    "r2:create": "wrangler r2 bucket create scarlet-curiosity-uploads"
  },
  "keywords": [
    "cloudflare-pages",
    "cloudflare-r2",
    "cloudflare-d1",
    "ticketing-system"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.0",
    "mysql2": "^3.18.2",
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  }
}
